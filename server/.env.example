# 复制为 .env 后填入真实值；.env 不要提交到仓库、不要打进 zip
PORT=5000
NODE_ENV=development

# MongoDB Atlas 连接串
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/capstone?retryWrites=true&w=majority

# JWT 签名密钥（随便一串足够长的随机字符）
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# 允许跨域的前端地址，逗号分隔；留空 = 允许所有来源（仅开发用）
# 部署后示例：CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# npm run seed 使用的管理员身份（账号已存在时只补角色，不覆盖密码）
# SEED_ADMIN_EMAIL 缺失时 seed 会直接报错退出，避免误建弱口令账号
# SEED_ADMIN_PASSWORD 留空则随机生成，并在输出里打印一次
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_USERNAME=yourname
SEED_ADMIN_PASSWORD=
